{
  "$extends": "solaredge",
  "class": "battery",
  "capabilities": [
    "measure_power",
    "measure_battery",
    "battery_charging_state",
    "meter_power.charged",
    "meter_power.discharged",
    "alarm_connectivity"
  ],
  "energy": {
    "homeBattery": true,
    "meterPowerImportedCapability": "meter_power.charged",
    "meterPowerExportedCapability": "meter_power.discharged"
  },
  "capabilitiesOptions": {
    "meter_power.charged": {
      "decimals": 3
    },
    "meter_power.discharged": {
      "decimals": 3
    }
  }
}
