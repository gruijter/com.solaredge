{
  "$app": {
    "name": "SolarEdge",
    "description": "L'énergie au service de nos vies dans le monde entier"
  },
  "$capabilities": {
    "solaredge-home-load-controller-state": {
      "title": "État"
    }
  },
  "$flow": {
    "triggers": {
      "inverter_status_changed": {
        "title": "État de l'onduleur modifié",
        "tokens": {
          "inverter_status": {
            "title": "État de l'onduleur"
          }
        }
      },
      "meter_power.day_changed": {
        "title": "Énergie du jour modifiée",
        "tokens": {
          "meter_power.day": {
            "title": "Production aujourd'hui"
          }
        }
      },
      "measure_voltage.1_changed": {
        "title": "Tension phase 1 modifiée",
        "tokens": {
          "measure_voltage.1": {
            "title": "Tension phase 1 (CA)"
          }
        }
      },
      "measure_voltage.2_changed": {
        "title": "Tension phase 2 modifiée",
        "tokens": {
          "measure_voltage.2": {
            "title": "Tension phase 2 (CA)"
          }
        }
      },
      "measure_voltage.3_changed": {
        "title": "Tension phase 3 modifiée",
        "tokens": {
          "measure_voltage.3": {
            "title": "Tension phase 3 (CA)"
          }
        }
      },
      "measure_power.load_changed": {
        "title": "Consommation domestique modifiée",
        "tokens": {
          "measure_power.load": {
            "title": "Consommation domestique"
          }
        }
      },
      "meter_power.imported_changed": {
        "title": "Énergie importée modifiée",
        "tokens": {
          "meter_power.imported": {
            "title": "Énergie importée"
          }
        }
      },
      "meter_power.exported_changed": {
        "title": "Énergie exportée modifiée",
        "tokens": {
          "meter_power.exported": {
            "title": "Énergie exportée"
          }
        }
      },
      "ev_charge_mode_changed": {
        "title": "Le mode de charge a changé",
        "tokens": {
          "ev_charge_mode": {
            "title": "Mode de charge"
          }
        }
      },
      "ev_solar_charging_true": {
        "title": "Recharge solaire activée"
      },
      "ev_solar_charging_false": {
        "title": "Recharge solaire désactivée"
      },
      "solaredge-home-load-controller-state_changed": {
        "title": "L'état a changé",
        "tokens": {
          "solaredge-home-load-controller-state": {
            "title": "État"
          }
        }
      }
    },
    "conditions": {
      "inverter_status_is": {
        "title": "L'état de l'onduleur est ...",
        "titleFormatted": "État de l'onduleur !{{est|n'est pas}} [[status]]",
        "args": {
          "status": {
            "title": "État de l'onduleur"
          }
        }
      },
      "ev_charge_mode_is": {
        "title": "Le mode de charge est ...",
        "titleFormatted": "Le mode de charge !{{est|n'est pas}} [[mode]]",
        "args": {
          "mode": {
            "title": "Mode de charge"
          }
        }
      },
      "ev_solar_charging_is": {
        "title": "La recharge solaire est activée",
        "titleFormatted": "La recharge solaire !{{est|n'est pas}} activée"
      },
      "solaredge-home-load-controller-state_is": {
        "title": "L'état est ...",
        "titleFormatted": "L'état !{{est|n'est pas}} [[state]]",
        "args": {
          "state": {
            "title": "État"
          }
        }
      }
    },
    "actions": {
      "home-load-controller-set-state": {
        "title": "Définir l'état",
        "titleFormatted": "Définir l'état sur [[state]]",
        "args": {
          "state": {
            "title": "État"
          }
        }
      },
      "evcharger-set-auto": {
        "title": "Charger automatiquement",
        "hint": "Retour au planning et à la recharge sur surplus solaire de la borne."
      }
    }
  },
  "$drivers": {
    "battery": {
      "name": "Batterie",
      "settings": {
        "username": {
          "label": "Nom d'utilisateur"
        },
        "password": {
          "label": "Mot de passe"
        },
        "poll_interval": {
          "label": "Intervalle d'interrogation (secondes)",
          "hint": "S'applique à tous les appareils de ce compte."
        }
      },
      "capabilitiesOptions": {
        "meter_power.charged": {
          "title": "Énergie chargée"
        },
        "meter_power.discharged": {
          "title": "Énergie déchargée"
        }
      }
    },
    "evcharger": {
      "name": "Borne de recharge VE",
      "settings": {
        "username": {
          "label": "Nom d'utilisateur"
        },
        "password": {
          "label": "Mot de passe"
        },
        "poll_interval": {
          "label": "Intervalle d'interrogation (secondes)",
          "hint": "S'applique à tous les appareils de ce compte."
        }
      },
      "capabilitiesOptions": {
        "meter_power.charged": {
          "title": "Énergie totale chargée"
        },
        "meter_power.session": {
          "title": "Énergie de cette session"
        }
      }
    },
    "inverter": {
      "name": "Onduleur",
      "settings": {
        "username": {
          "label": "Nom d'utilisateur"
        },
        "password": {
          "label": "Mot de passe"
        },
        "poll_interval": {
          "label": "Intervalle d'interrogation (secondes)",
          "hint": "S'applique à tous les appareils de ce compte."
        }
      },
      "capabilitiesOptions": {
        "measure_power": {
          "title": "Puissance produite"
        },
        "meter_power": {
          "title": "Production totale"
        },
        "meter_power.day": {
          "title": "Production aujourd'hui"
        },
        "meter_power.month": {
          "title": "Production ce mois-ci"
        },
        "meter_power.year": {
          "title": "Production cette année"
        },
        "measure_voltage.1": {
          "title": "Tension phase 1 (CA)"
        },
        "measure_voltage.2": {
          "title": "Tension phase 2 (CA)"
        },
        "measure_voltage.3": {
          "title": "Tension phase 3 (CA)"
        },
        "measure_temperature.max": {
          "title": "Température max. des optimiseurs aujourd'hui"
        }
      }
    },
    "meter": {
      "name": "Compteur",
      "settings": {
        "username": {
          "label": "Nom d'utilisateur"
        },
        "password": {
          "label": "Mot de passe"
        },
        "poll_interval": {
          "label": "Intervalle d'interrogation (secondes)",
          "hint": "S'applique à tous les appareils de ce compte."
        }
      },
      "capabilitiesOptions": {
        "meter_power.imported": {
          "title": "Énergie importée"
        },
        "meter_power.exported": {
          "title": "Énergie exportée"
        },
        "measure_power.grid": {
          "title": "Puissance réseau"
        },
        "measure_power.solar": {
          "title": "Puissance solaire"
        },
        "measure_power.load": {
          "title": "Consommation domestique"
        }
      }
    },
    "home-load-controller": {
      "name": "Contrôleur de charge domestique",
      "settings": {
        "username": {
          "label": "Nom d'utilisateur"
        },
        "password": {
          "label": "Mot de passe"
        },
        "poll_interval": {
          "label": "Intervalle d'interrogation (secondes)",
          "hint": "S'applique à tous les appareils de ce compte."
        }
      }
    }
  },
  "migrating": "Mise à jour des capacités…"
}
