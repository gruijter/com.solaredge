          "hint": "Gjelder for alle enheter på denne kontoen."
        }
      },
      "capabilitiesOptions": {
        "measure_power": {
          "title": "Soleffekt (AC)"
        },
        "meter_power": {
          "title": "Solproduksjon (AC)"
        },
        "meter_power.day": {
          "title": "Produksjon i dag (AC)"
        },
        "meter_power.month": {
          "title": "Produksjon denne måneden (AC)"
        },
        "meter_power.year": {
          "title": "Produksjon i år (AC)"
        },
        "measure_voltage.1": {
          "title": "Spenning fase 1 (AC)"
        },
        "measure_voltage.2": {
          "title": "Spenning fase 2 (AC)"
        },
        "measure_voltage.3": {
          "title": "Spenning fase 3 (AC)"
        },
        "measure_temperature.max": {
          "title": "Maks. optimalisatortemperatur i dag"
        }
      }
    },
    "meter": {
      "name": "Måler",
      "settings": {
