{
  "$app": {
    "name": "SolarEdge",
    "description": "Het leven van mensen over de hele wereld stimuleren"
  },
  "$capabilities": {
    "solaredge-home-load-controller-state": {
      "title": "Status"
    }
  },
  "$flow": {
    "triggers": {
      "inverter_status_changed": {
        "title": "Omvormerstatus is veranderd",
        "tokens": {
          "inverter_status": {
            "title": "Omvormerstatus"
          }
        }
      },
      "meter_power.day_changed": {
        "title": "Energie vandaag is veranderd",
        "tokens": {
          "meter_power.day": {
            "title": "Opgewekt vandaag"
          }
        }
      },
      "measure_voltage.1_changed": {
        "title": "Spanning fase 1 is veranderd",
        "tokens": {
          "measure_voltage.1": {
            "title": "Spanning fase 1 (AC)"
          }
        }
      },
      "measure_voltage.2_changed": {
        "title": "Spanning fase 2 is veranderd",
        "tokens": {
          "measure_voltage.2": {
            "title": "Spanning fase 2 (AC)"
          }
        }
      },
      "measure_voltage.3_changed": {
        "title": "Spanning fase 3 is veranderd",
        "tokens": {
          "measure_voltage.3": {
            "title": "Spanning fase 3 (AC)"
          }
        }
      },
      "measure_power.load_changed": {
        "title": "Thuisverbruik is veranderd",
        "tokens": {
          "measure_power.load": {
            "title": "Thuisverbruik"
          }
        }
      },
      "meter_power.imported_changed": {
        "title": "Afgenomen energie is veranderd",
        "tokens": {
          "meter_power.imported": {
            "title": "Geïmporteerde energie"
          }
        }
      },
      "meter_power.exported_changed": {
        "title": "Teruggeleverde energie is veranderd",
        "tokens": {
          "meter_power.exported": {
            "title": "Geëxporteerde energie"
          }
        }
      },
      "ev_charge_mode_changed": {
        "title": "Laadmodus is veranderd",
        "tokens": {
          "ev_charge_mode": {
            "title": "Laadmodus"
          }
        }
      },
      "ev_solar_charging_true": {
        "title": "Laden op zonne-overschot ingeschakeld"
      },
      "ev_solar_charging_false": {
        "title": "Laden op zonne-overschot uitgeschakeld"
      },
      "solaredge-home-load-controller-state_changed": {
        "title": "Status is veranderd",
        "tokens": {
          "solaredge-home-load-controller-state": {
            "title": "Status"
          }
        }
      }
    },
    "conditions": {
      "inverter_status_is": {
        "title": "Omvormerstatus is ...",
        "titleFormatted": "Omvormerstatus !{{is|is niet}} [[status]]",
        "args": {
          "status": {
            "title": "Omvormerstatus"
          }
        }
      },
      "ev_charge_mode_is": {
        "title": "Laadmodus is ...",
        "titleFormatted": "Laadmodus !{{is|is niet}} [[mode]]",
        "args": {
          "mode": {
            "title": "Laadmodus"
          }
        }
      },
      "ev_solar_charging_is": {
        "title": "Laden op zonne-overschot staat aan",
        "titleFormatted": "Laden op zonne-overschot !{{staat|staat niet}} aan"
      },
      "solaredge-home-load-controller-state_is": {
        "title": "Status is ...",
        "titleFormatted": "Status !{{is|is niet}} [[state]]",
        "args": {
          "state": {
            "title": "Status"
          }
        }
      }
    },
    "actions": {
      "home-load-controller-set-state": {
        "title": "Stel de status in",
        "titleFormatted": "Stel de status in op [[state]]",
        "args": {
          "state": {
            "title": "Status"
          }
        }
      },
      "evcharger-set-auto": {
        "title": "Automatisch laden",
        "hint": "Terug naar het schema en laden op zonne-overschot van de lader."
      }
    }
  },
  "$drivers": {
    "battery": {
      "name": "Batterij",
      "settings": {
        "username": {
          "label": "Gebruikersnaam"
        },
        "password": {
          "label": "Wachtwoord"
        },
        "poll_interval": {
          "label": "Pollinterval (seconden)",
          "hint": "Geldt voor alle apparaten van dit account."
        }
      },
      "capabilitiesOptions": {
        "meter_power.charged": {
          "title": "Geladen energie"
        },
        "meter_power.discharged": {
          "title": "Ontladen energie"
        }
      }
    },
    "evcharger": {
      "name": "EV-lader",
      "settings": {
        "username": {
          "label": "Gebruikersnaam"
        },
        "password": {
          "label": "Wachtwoord"
        },
        "poll_interval": {
          "label": "Pollinterval (seconden)",
          "hint": "Geldt voor alle apparaten van dit account."
        }
      },
      "capabilitiesOptions": {
        "meter_power.charged": {
          "title": "Meterstand"
        },
        "meter_power.session": {
          "title": "Energie deze sessie"
        }
      }
    },
    "inverter": {
      "name": "Omvormer",
      "settings": {
        "username": {
          "label": "Gebruikersnaam"
        },
        "password": {
          "label": "Wachtwoord"
        },
        "poll_interval": {
          "label": "Pollinterval (seconden)",
          "hint": "Geldt voor alle apparaten van dit account."
        }
      },
      "capabilitiesOptions": {
        "measure_power": {
          "title": "Zonnevermogen (AC)"
        },
        "meter_power": {
          "title": "Zonopbrengst (AC)"
        },
        "meter_power.day": {
          "title": "Opbrengst vandaag (AC)"
        },
        "meter_power.month": {
          "title": "Opbrengst deze maand (AC)"
        },
        "meter_power.year": {
          "title": "Opbrengst dit jaar (AC)"
        },
        "measure_voltage.1": {
          "title": "Spanning fase 1 (AC)"
        },
        "measure_voltage.2": {
          "title": "Spanning fase 2 (AC)"
        },
        "measure_voltage.3": {
          "title": "Spanning fase 3 (AC)"
        },
        "measure_temperature.max": {
          "title": "Max. optimizertemperatuur vandaag"
        }
      }
    },
    "meter": {
      "name": "Meter",
      "settings": {
        "username": {
          "label": "Gebruikersnaam"
        },
        "password": {
          "label": "Wachtwoord"
        },
        "poll_interval": {
          "label": "Pollinterval (seconden)",
          "hint": "Geldt voor alle apparaten van dit account."
        }
      },
      "capabilitiesOptions": {
        "meter_power.imported": {
          "title": "Energie import"
        },
        "meter_power.exported": {
          "title": "Energie export"
        },
        "measure_power.grid": {
          "title": "Netvermogen"
        },
        "measure_power.solar": {
          "title": "Zonnevermogen (AC)"
        },
        "measure_power.load": {
          "title": "Thuisverbruik"
        }
      }
    },
    "home-load-controller": {
      "name": "Huislastregelaar",
      "settings": {
        "username": {
          "label": "Gebruikersnaam"
        },
        "password": {
          "label": "Wachtwoord"
        },
        "poll_interval": {
          "label": "Pollinterval (seconden)",
          "hint": "Geldt voor alle apparaten van dit account."
        }
      }
    }
  },
  "migrating": "Capabilities bijwerken…"
}
