          "label": "Password"
        },
        "poll_interval": {
          "label": "Intervallo di polling (secondi)",
          "hint": "Vale per tutti i dispositivi di questo account."
        }
      },
      "capabilitiesOptions": {
        "meter_power.imported": {
          "title": "Energia importata"
        },
        "meter_power.exported": {
          "title": "Energia esportata"
        },
        "measure_power.grid": {
          "title": "Potenza di rete"
        },
        "measure_power.solar": {
          "title": "Potenza solare"
        },
        "measure_power.load": {
          "title": "Consumo domestico"
        }
      }
    },
    "home-load-controller": {
      "name": "Controller dei carichi domestici",
