          "label": "Nome utente"
        },
        "password": {
          "label": "Password"
        },
        "poll_interval": {
          "label": "Intervallo di polling (secondi)",
          "hint": "Vale per tutti i dispositivi di questo account."
        }
      },
      "capabilitiesOptions": {
        "measure_power": {
          "title": "Potenza solare (CA)"
        },
        "meter_power": {
          "title": "Produzione totale"
        },
        "meter_power.day": {
          "title": "Prodotto oggi"
        },
        "meter_power.month": {
          "title": "Prodotto questo mese"
        },
        "meter_power.year": {
          "title": "Prodotto quest'anno"
        },
        "measure_voltage.1": {
          "title": "Tensione fase 1 (CA)"
        },
        "measure_voltage.2": {
          "title": "Tensione fase 2 (CA)"
        },
        "measure_voltage.3": {
          "title": "Tensione fase 3 (CA)"
        },
        "measure_temperature.max": {
          "title": "Temperatura max ottimizzatori oggi"
        }
      }
    },
    "meter": {
      "name": "Contatore",
      "settings": {
        "username": {
