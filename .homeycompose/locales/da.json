        "meter_power.day": {
          "title": "Produktion i dag (AC)"
        },
        "meter_power.month": {
          "title": "Produktion denne måned (AC)"
        },
        "meter_power.year": {
          "title": "Produktion i år (AC)"
        },
        "measure_voltage.1": {
          "title": "Spænding fase 1 (AC)"
        },
        "measure_voltage.2": {
          "title": "Spænding fase 2 (AC)"
        },
        "measure_voltage.3": {
          "title": "Spænding fase 3 (AC)"
        },
        "measure_temperature.max": {
          "title": "Maks. optimizertemperatur i dag"
        }
      }
    },
    "meter": {
      "name": "Måler",
      "settings": {
