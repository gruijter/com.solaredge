{
  "$app": {
    "name": "SolarEdge",
    "description": "Energie für Menschen – weltweit"
  },
  "$capabilities": {
    "solaredge-home-load-controller-state": {
      "title": "Zustand"
    }
  },
  "$flow": {
    "actions": {
      "home-load-controller-set-state": {
        "title": "Zustand festlegen",
        "titleFormatted": "Zustand auf [[state]] festlegen",
        "args": {
          "state": {
            "title": "Zustand"
          }
        }
      }
    }
  },
  "$drivers": {
    "battery": {
      "name": "Batterie",
      "settings": {
        "username": {
          "label": "Benutzername"
        },
        "password": {
          "label": "Passwort"
        }
      }
    },
    "evcharger": {
      "name": "EV-Ladegerät",
      "settings": {
        "username": {
          "label": "Benutzername"
        },
        "password": {
          "label": "Passwort"
        }
      },
      "capabilitiesOptions": {
        "meter_power.charged": {
          "title": "Geladene Gesamtenergie"
        },
        "meter_power.discharged": {
          "title": "Entladene Gesamtenergie"
        }
      }
    },
    "inverter": {
      "name": "Wechselrichter",
      "settings": {
        "username": {
          "label": "Benutzername"
        },
        "password": {
          "label": "Passwort"
        }
      },
      "capabilitiesOptions": {
        "measure_power": {
          "title": "Erzeugte Leistung"
        },
        "meter_power": {
          "title": "Gesamterzeugung"
        },
        "meter_power.day": {
          "title": "Erzeugung heute"
        },
        "meter_power.month": {
          "title": "Erzeugung diesen Monat"
        },
        "meter_power.year": {
          "title": "Erzeugung dieses Jahr"
        }
      }
    },
    "meter": {
      "name": "Zähler",
      "settings": {
        "username": {
          "label": "Benutzername"
        },
        "password": {
          "label": "Passwort"
        }
      },
      "capabilitiesOptions": {
        "meter_power.imported": {
          "title": "Importierte Energie"
        },
        "meter_power.exported": {
          "title": "Exportierte Energie"
        },
        "measure_power.grid": {
          "title": "Netzleistung"
        },
        "measure_power.solar": {
          "title": "Solarleistung"
        }
      }
    },
    "home-load-controller": {
      "name": "Hauslaststeuerung",
      "settings": {
        "username": {
          "label": "Benutzername"
        },
        "password": {
          "label": "Passwort"
        }
      }
    }
  }
}
