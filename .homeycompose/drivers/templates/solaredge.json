{
  "platforms": [
    "local",
    "cloud"
  ],
  "connectivity": [
    "cloud"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "logo": "logo.svg"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "id": "username",
      "type": "text"
    },
    {
      "id": "password",
      "type": "password"
    },
    {
      "id": "poll_interval",
      "type": "number",
      "value": 10,
      "min": 5,
      "max": 300,
      "step": 1
    }
  ]
}
